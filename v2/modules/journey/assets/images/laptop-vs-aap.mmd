%%{init: {"theme": "base", "look": "classic", "fontFamily": "arial, sans-serif", "flowchart": {"htmlLabels": false}, "themeVariables": {"fontSize": "14px", "primaryColor": "#ffffff", "primaryTextColor": "#28253D", "primaryBorderColor": "#28253D", "lineColor": "#000000"}}}%%
flowchart TD
    setup([Prepare the environment]) --> aap{AAP already running?}
    aap -- yes --> inv[Build inventory, validate the environment]
    aap -- no --> deploy[Deploy AAP on OpenShift<br/>one of the last laptop CLI steps]
