%%{init: {"theme": "base", "look": "classic", "fontFamily": "arial, sans-serif", "flowchart": {"htmlLabels": false}, "themeVariables": {"fontSize": "14px", "primaryColor": "#ffffff", "primaryTextColor": "#28253D", "primaryBorderColor": "#28253D", "lineColor": "#000000"}}}%%
flowchart TD
    start([Set up Ansible Automation Platform]) --> lab{Red Hat Demo Platform lab?}
    lab -- yes --> rhdp[Use the RHDP workshop]
    lab -- no --> have{AAP already running?}
    have -- yes --> existing[Use the AAP you already run<br/>default]
    have -- no --> deploy[Deploy AAP on OpenShift<br/>laptop CLI]
    existing --> inv[Add the AAP URL and admin<br/>credentials to the inventory]
    deploy --> inv
    rhdp --> seed([Continue to Seeding<br/>Ansible Automation Platform])
    inv --> seed
    classDef laptop fill:#ffffff,stroke:#ee0000,stroke-width:1.5px;
    class deploy laptop
