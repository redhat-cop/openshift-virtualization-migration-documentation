# Copy to lab.env and fill real values. NEVER commit lab.env.
#   cp utilities/quick-start-lab/lab.env.example utilities/quick-start-lab/lab.env

# --- Bastion (run Gate 0 / oc / curl from here) ---
BASTION_HOST=23.88.73.30
BASTION_USER=root
BASTION_SSH_KEY=/Users/you/.ssh/id_rsa_open
BASTION_SSH_PORT=22
BASTION_WORKDIR=/root/migration-factory-lab

# --- OpenShift destination ---
OCP_API=https://api.example.com:6443
OCP_USER=kubeadmin
OCP_PASSWORD=changeme
# Optional: long-lived SA token (preferred for inventory). Leave empty to mint via oc login.
OCP_TOKEN=
OCP_INSECURE=true

# --- Ansible Automation Platform ---
AAP_URL=https://aap.apps.example.com
AAP_USER=admin
AAP_PASSWORD=changeme
# Preferred on AAP 2.5+: gateway OAuth token (bootstrap/seed-aap.sh can mint this)
AAP_TOKEN=
# AAP 2.5+ gateway path: /api/controller/v2 (not /api/v2)
AAP_API_PREFIX=/api/controller/v2
# Set to 1 to run seed after Gate 0/inventory
SEED_AAP=0

# --- VMware source (standalone ESXi supported by MTV 2.6+) ---
# Endpoint type for MTV Provider settings.sdkEndpoint: esxi | vcenter
VMWARE_SDK_ENDPOINT_TYPE=esxi
VMWARE_HOST=192.168.50.145
VMWARE_SDK_PATH=/sdk
VMWARE_USER=root
VMWARE_PASSWORD=changeme
VMWARE_VALIDATE_CERTS=false
# Required for cold copy on standalone ESXi (ConvertGuest / raw copy). Build your own
# entitled image — see https://github.com/redhat-cop/openshift-virtualization-vmware-vddk
# Internal RHDP/demo tags are not for customer use.
VDDK_IMAGE=

# --- First cold VM (quick-start Path A prefers RHEL) ---
COLD_VM_NAME=rhel-10
TARGET_NAMESPACE=vm-workloads
PLAN_NAME=quickstart-cold-01

# --- Inventory host aliases (logical names, not DNS) ---
INV_AAP_HOST=aap-instance
INV_SOURCE_HOST=esxi-lab
INV_CLUSTER_HOST=ocp-lab

# --- Collection / EE ---
AAP_PROJECT_SCM_URL=https://github.com/redhat-cop/openshift_virtualization_migration.git
AAP_PROJECT_SCM_BRANCH=v2
EE_IMAGE=quay.io/redhat-cop/openshift-virtualization-migration-ee:latest
# From Bitwarden collection "Migration Factory" (Red Hat Hub Bitwarden — see
# KB0010984 + Request help). Never commit real values.
QUAY_USER=
QUAY_PASSWORD=

# Skip local podman EE check (1) when you will prove pull only via AAP
SKIP_PODMAN_EE=1
